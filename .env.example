# Copy to .env.local (git-ignored) and fill in with the OAuth client IDs from Google Cloud Console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FITEXERCISEDB_API_KEY=

# Where the user's data is kept: `local` (in memory, lost when the app restarts) or `supabase`.
EXPO_PUBLIC_DATA_SOURCE=local
